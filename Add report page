<!doctype html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Scam Guard - Report Scam</title>
<style>
body{margin:0;font-family:Arial;background:#f5f7fb;color:#111827}
.wrap{max-width:700px;margin:auto;padding:18px}
.card{background:white;padding:20px;border-radius:18px;margin-top:20px;box-shadow:0 2px 10px #0001}
h1{margin-top:0}
input,select,textarea{width:100%;box-sizing:border-box;padding:13px;margin:8px 0 15px;border:1px solid #ddd;border-radius:10px;font-size:16px}
textarea{min-height:100px}
button{width:100%;padding:14px;border:0;border-radius:10px;background:#111827;color:white;font-weight:bold;font-size:16px}
#msg{margin-top:15px;padding:12px;border-radius:10px;display:none}
.success{background:#dcf8df}
.error{background:#ffe0e0}
</style>
</head>

<body>
<div class="wrap">

<div class="card">
<h1>📢 Report a Scam</h1>
<p>Suspicious App, Website या payment की जानकारी दें।</p>

<label>📱 App / Website Name</label>
<input id="app_name" placeholder="जैसे Xyz treading app">

<label>🔗 Website URL</label>
<input id="website_url" placeholder="https://example.com">

<label>💳 UPI ID</label>
<input id="upi_id" placeholder="example@upi">

<label>⚠️ Scam Type</label>
<select id="scam_type">
<option value="">Select करें</option>
<option>Withdrawal problem</option>
<option>Fake payment</option>
<option>Fraud</option>
<option>Investment scam</option>
<option>Currency exchange fee</option>
<option>Other</option>
</select>

<label>📝 Description</label>
<textarea id="description" placeholder="क्या हुआ, यहाँ लिखें"></textarea>

<label>💰 Amount</label>
<input id="amount" type="number" placeholder="₹ Amount">

<button onclick="submitReport()">📤 Submit Report</button>

<div id="msg"></div>
</div>

</div>

<script>

const base="https://zdsvmqtfzprlfsggdepd.supabase.co";

const key="sb_publishable_ipHcSbMphfOBKG-ijTJDfQ_CSi-ZZZ4";

async function submitReport(){

const msg=document.getElementById("msg");

const app_name=document.getElementById("app_name").value.trim();
const website_url=document.getElementById("website_url").value.trim();
const upi_id=document.getElementById("upi_id").value.trim();
const scam_type=document.getElementById("scam_type").value;
const description=document.getElementById("description").value.trim();
const amount=document.getElementById("amount").value;

if(!app_name && !website_url && !upi_id){
msg.style.display="block";
msg.className="error";
msg.textContent="⚠️ App, Website या UPI ID में से कम से कम एक भरें।";
return;
}

msg.style.display="block";
msg.className="";
msg.textContent="⏳ Report submit हो रही है...";

try{

const response=await fetch(base+"/rest/v1/scam_reports",{
method:"POST",
headers:{
"apikey":key,
"Authorization":"Bearer "+key,
"Content-Type":"application/json",
"Prefer":"return=minimal"
},
body:JSON.stringify({
app_name:app_name || null,
website_url:website_url || null,
upi_id:upi_id || null,
scam_type:scam_type || null,
description:description || null,
amount:amount ? Number(amount) : null,
status:"unverified"
})
});

const result=await response.text();

if(!response.ok){
throw new Error(result);
}

msg.className="success";
msg.textContent="✅ Report successfully submit हो गई।";

document.getElementById("app_name").value="";
document.getElementById("website_url").value="";
document.getElementById("upi_id").value="";
document.getElementById("scam_type").value="";
document.getElementById("description").value="";
document.getElementById("amount").value="";

}catch(error){

msg.className="error";
msg.textContent="❌ Error: "+error.message;

}

}

</script>
</body>
</html>
